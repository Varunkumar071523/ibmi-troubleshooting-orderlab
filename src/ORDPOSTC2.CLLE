/* ================================================================ */
/* ORDPOSTC2 Driver for corrected invoice posting     (CASE-014)    */
/* Calls ORDPOST2 and ends the job with an escape message if the     */
/* posting program reports that it stopped.                         */
/* Same driver as ORDPOSTC, calling the corrected ORDPOST2.        */
/*                                                                  */
/* Compile: CRTBNDCL PGM(ORDLAB/ORDPOSTC2) SRCFILE(ORDLAB/QCLSRC)   */
/* Status: written, NOT yet compiled or executed on IBM i.          */
/* ================================================================ */
PGM

  DCL        VAR(&OK) TYPE(*CHAR) LEN(1)

  CALL       PGM(ORDPOST2) PARM(&OK)

  IF         COND(&OK *NE 'Y') THEN(SNDPGMMSG MSGID(CPF9898) +
               MSGF(QCPFMSG) MSGDTA('Invoice posting stopped. +
               See ORDEXCP for the order and SQLCODE') +
               MSGTYPE(*ESCAPE))

  SNDPGMMSG  MSG('Invoice posting completed.') TOPGMQ(*EXT)

ENDPGM
